# Server Configuration
APP_PORT=8081
LOG_LEVEL=debug

# Database Connection (Connect directly to Remote Server's Database for Dev)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=fahfon_iot
DB_URL=postgres://your-db-user:your-db-password@127.0.0.1:5432/fahfon_iot?sslmode=disable&TimeZone=Asia/Bangkok

# MongoDB Connection
MONGO_URI=mongodb://your-mongo-user:your-mongo-password@127.0.0.1:27017/userProfile?authSource=admin
MONGO_DB=userProfile

# Security
JWT_SECRET=your-jwt-secret-key
JWT_LIFETIME=24h
DB_QUERY_TIMEOUT=10s

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=your-redis-user
REDIS_PASSWORD=your-redis-password

# River Service URL
RIVER_SERVICE_URL=http://127.0.0.1:8081
RIVER_DB_URL=postgres://your-river-db-user:your-river-db-password@127.0.0.1:5432/ff_river?sslmode=disable

# River Redis Configuration
RIVER_REDIS_HOST=127.0.0.1
RIVER_REDIS_PORT=6379
RIVER_REDIS_PASSWORD=your-river-redis-password

# River Image Service Configuration
RIVER_STORAGE_BASE_URL=http://127.0.0.1
RIVER_IMAGE_CDN_URL=http://127.0.0.1/cdn
RIVER_IMGPROXY_KEY=your-imgproxy-key
RIVER_IMGPROXY_SALT=your-imgproxy-salt

# CCTV Media Stream Service
CCTV_STREAM_SERVICE_ADDR=127.0.0.1:50051
CCTV_STREAM_SERVICE_SECRET=your-cctv-stream-service-secret
